	<control id="center_view_and_freelook_reset" type="discrete">
		<action id ="center_view_and_freelook_reset">
			<joystick_mapping>
				<joystick_name>T.Flight Stick X</joystick_name>
				<joystick_guid></joystick_guid>
				<button_mapping>
					<button>1</button>
				</button_mapping>
			</joystick_mapping>
			<key_mapping>
				<key>space</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</key_mapping>
			<!--ctrl_value>2.0</ctrl_value-->
			<!--execution type="sim_var">
				<sim_var_name>COCKPIT_CAMERA_HEADLOOK</sim_var_name>
				<repeats>1</repeats>
				<value>2.0</value>
			</execution-->				
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - LOAD CUSTOM CAMERA 0 -->
				<key>`</key> <!-- This is º in spanish keyboards -->
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
				<!--repeats>1</repeats-->
				<!--delay_ms_after_pressed>10</delay_ms_after_pressed-->
			</execution>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TOGGLE COCKPIT FREELOOK -->
				<key>f</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>true</alt>
			</execution>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TOGGLE COCKPIT FREELOOK -->
				<key>f</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>true</alt>
				<conditions>
					<condition type="simvar_check" id="COCKPIT_CAMERA_HEADLOOK">
						<value>1.0</value>
					</condition>
				</conditions>
			</execution>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - RESET COCKPIT VIEW -->
				<key>space</key>
				<shift>true</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</execution>
			<!--execution type="sim_var">
				<sim_var_name>CAMERA_ACTION_COCKPIT_VIEW_RESET</sim_var_name>
				<repeats>1</repeats>
				<delay_ms_after_pressed>2000</delay_ms_after_pressed>
				<conditions/>
			</execution-->
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_left" type="discrete">
		<action id ="cockpit_eyepoint_left">
			<key_mapping>
				<key>left</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TRANSLATE COCKPIT VIEW LEFT -->
				<key>left</key>
				<shift>true</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_right" type="discrete">
		<action id ="cockpit_eyepoint_right">
			<key_mapping>
				<key>right</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TRANSLATE COCKPIT VIEW RIGHT -->
				<key>right</key>
				<shift>true</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_up" type="discrete">
		<action id ="cockpit_eyepoint_up">
			<key_mapping>
				<key>up</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - INCREASE COCKPIT VIEW HEIGHT-->
				<key>up</key>
				<shift>true</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_down" type="discrete">
		<action id ="cockpit_eyepoint_down">
			<key_mapping>
				<key>down</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - DECREASE COCKPIT VIEW HEIGHT -->
				<key>down</key>
				<shift>true</shift> 
				<ctrl>false</ctrl>
				<alt>false</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_forward" type="discrete">
		<action id ="cockpit_eyepoint_forward">
			<key_mapping>
				<key>up</key>
				<shift>false</shift> 
				<ctrl>true</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TRANSLATE COCKPIT VIEW FORWARD -->
				<key>up</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>true</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
	<control id="cockpit_eyepoint_backward" type="discrete">
		<action id ="cockpit_eyepoint_backward">
			<key_mapping>
				<key>down</key>
				<shift>false</shift> 
				<ctrl>true</ctrl>
				<alt>false</alt>
			</key_mapping>
			<execution type="key_press"> <!-- Match to assignment Keyboard - Camera - Cockpit Camera - TRANSLATE COCKPIT VIEW BACKWARD -->
				<key>down</key>
				<shift>false</shift> 
				<ctrl>false</ctrl>
				<alt>true</alt>
			</execution>		
		</action>
		<repeat>false</repeat>
	</control>
	
</config>